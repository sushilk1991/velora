    {
      "id": "sotto-train-124928",
      "category": "correction_residue_grammar",
      "status": "incompatible",
      "severity": "low",
      "reason": "The target joins the corrected amount to the unrepaired suffix as “was one hundred and fifty is the real number.” This malformed correction seam is not clean, well-punctuated prose under the actual Default template. The final amount is correct, but the target teaches an unclean correction boundary.",
      "instruction": "Produce clean, well-punctuated prose."
    },
    {
      "id": "lfm3-final-syn-056",
      "category": "message_case_contract",
      "status": "incompatible",
      "severity": "medium",
      "reason": "The entirely lowercase source is converted to sentence-initial uppercase “The”. The attached Message template explicitly requires preservation of lowercase-style informality; removing the trailing period alone is insufficient.",
      "instruction": "Lowercase-style informality in the original should be preserved; do not make it formal."
    },
    {
      "id": "lfm3-final-syn-058",
      "category": "unretracted_object_deleted",
      "status": "incompatible",
      "severity": "high",
      "reason": "The correction changes the action from ironing to hanging dry, but it does not retract which garment is involved. The target deletes the only “silk shirt” noun phrase and begins with an antecedentless “it”, losing the object and its material qualifier.",
      "instruction": "Keep the user's wording and sentence order; only fix punctuation, capitalization, fillers, and self-corrections."
    },
    {
      "id": "sotto-train-116544",
      "category": "corrected_action_object_lost",
      "status": "uncertain_exclude",
      "severity": "medium",
      "reason": "The source changes the intended first action from refactoring this module to adding a comment first. The target preserves the new action but loses the only module referent. It is arguable that the entire first proposal was retracted; because this also removes where the comment belongs, exclude this ambiguous label rather than assume the object was retracted.",
      "instruction": "Keep the user's wording and sentence order; only fix punctuation, capitalization, fillers, and self-corrections."
    },
    {
      "id": "sotto-relabel-0117",
      "category": "unretracted_qualifier_deleted",
      "status": "incompatible",
      "severity": "high",
      "reason": "The target corrects the budget amount to 150k but drops that the budget is for marketing. The amount is superseded; the marketing qualifier is not. The actual controls provide no prior context that restores this lost qualification.",
      "instruction": "Keep the user's wording and sentence order; only fix punctuation, capitalization, fillers, and self-corrections."
    },
    {
      "id": "muse-public-0097-served-default",
      "category": "note_target_paraphrase_under_default",
      "status": "incompatible",
      "severity": "medium",
      "reason": "List structure is allowed, but the unchanged note target also rewrites “that I can carry” to “to carry”, “so I can see” to “to see”, and the final first-person clause into an imperative. Those compressions are more than line breaks/list markers, and conflict with the newly attached Default instruction to keep wording.",
      "instruction": "Still never rewrite wording."
    },
    {
      "id": "muse-public-0097-served-terminal",
      "category": "note_target_paraphrase_under_terminal",
      "status": "incompatible",
      "severity": "medium",
      "reason": "Numbered structure fits SmartTerminal, but the target also compresses source-relative clauses and first-person wording into infinitives/imperatives. The FULL-strength no-rewrite instruction still applies to this terminal template; mandatory numbering does not authorize the wording changes.",
      "instruction": "Still never rewrite wording."
    },
    {
      "id": "muse-public-0093-served-default",
      "category": "note_target_paraphrase_under_default",
      "status": "incompatible",
      "severity": "medium",
      "reason": "The target changes “a short feedback form that we can hand out” to “a short feedback form to hand out”. Its list shape and quantities are compatible, but dropping/replacing the subject and modal is a wording rewrite under the new Default contract.",
      "instruction": "Still never rewrite wording."
    },
    {
      "id": "muse-public-0093-served-terminal",
      "category": "note_target_paraphrase_under_terminal",
      "status": "incompatible",
      "severity": "medium",
      "reason": "The numbered task list fits the terminal policy, but “that we can hand out” becomes “to hand out”. Mandatory list formatting does not waive the FULL instruction against rewriting wording.",
      "instruction": "Still never rewrite wording."
    },
    {
      "id": "serving-layout-006-served-terminal",
      "category": "smart_terminal_numbered_tasks_required",
      "status": "incompatible",
      "severity": "medium",
      "reason": "The source enumerates four separate actionable errands. The target puts them on bare lines, while this actual SmartTerminal template explicitly requires a numbered list for multiple distinct requests/tasks. The spoken one-errand-per-line request is compatible with numbering and does not request no numbering. This concern does not apply to bare value/product collections.",
      "instruction": "When that message contains two or more distinct problems, requests, constraints, or pieces of feedback, a numbered list is REQUIRED even if the speaker did not explicitly ask for one."
    }
