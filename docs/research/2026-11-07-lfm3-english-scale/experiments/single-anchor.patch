+// Opt-in only: after normal 2/3-token matching fails and >=2 tokens were
+// emitted, a globally unique exact token may locate a candidate. This does not
+// accept any token: the existing target precheck and batched verifier own that.
+inline CopyProposal copy_proposal_single_anchor(const std::vector<int32_t> & source,
+        const std::vector<int32_t> & output,size_t cursor,size_t limit,bool enabled) {
+    auto normal=copy_proposal(source,output,cursor,limit);
+    if(!enabled || !normal.tokens.empty() || output.size()<2 || !limit)return normal;
+    size_t found=source.size();
+    for(size_t i=0;i<source.size();++i)if(source[i]==output.back()){
+        if(found!=source.size())return {{},cursor};
+        found=i;
+    }
+    if(found==source.size() || found+1==source.size())return {{},cursor};
+    ++found;limit=std::min<size_t>(limit,8);
+    return {{source.begin()+found,source.begin()+std::min(source.size(),found+limit)},found,true};
+}
